<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:version='2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  
  <!-- Bootstrap 5 CSS CDN -->
  <link crossorigin='anonymous' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css' integrity='sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN' rel='stylesheet'/>
  
  <!-- Google Fonts -->
  <link href='https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap' rel='stylesheet'/>

  <!-- WAJIB: b:skin kosong untuk memenuhi syarat Blogger -->
  <b:skin><![CDATA[]]></b:skin>

  <!-- Custom CSS Area (Kita tulis CSS di sini agar aman)
 -->
  <style>
    body { font-family: &#39;Inter&#39;, sans-serif; }
  </style>
  
</head>
<body>

  <!-- HEADER SECTION -->
  <header class='bg-white shadow-sm sticky-top'>
    <div class='container py-3'>
      <nav class='navbar navbar-expand-lg navbar-light'>
        <a class='navbar-brand fw-bold' href='/'>Toko Baju Kita</a>
        <button class='navbar-toggler' data-bs-target='#navbarNav' data-bs-toggle='collapse' type='button'>
          <span class='navbar-toggler-icon'/>
        </button>
        <div class='collapse navbar-collapse' id='navbarNav'>
          <ul class='navbar-nav ms-auto'>
            <li class='nav-item'>
              <a class='nav-link active' href='/'>Beranda</a>
            </li>
            <li class='nav-item'>
              <a class='nav-link' href='#katalog'>Katalog</a>
            </li>
            <li class='nav-item'>
              <a class='nav-link' href='#kontak'>Kontak</a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </header>
  
    <!-- HERO SECTION -->
  <section class='bg-light py-5'>
    <div class='container'>
      <div class='row align-items-center'>
        <div class='col-md-6'>
          <h1 class='display-4 fw-bold'>Koleksi Baju Terbaik 2024</h1>
          <p class='lead'>Temukan pakaian dengan kualitas premium dan desain masa kini. Nyaman dipakai, harga bersahabat.</p>
          <a class='btn btn-primary btn-lg' href='#katalog'>Lihat Katalog</a>
        </div>
        <div class='col-md-6 text-center mt-4 mt-md-0'>
          <!-- Ganti URL gambar di bawah dengan gambar banner toko kamu -->
          <img alt='Banner Toko' class='img-fluid rounded shadow' src='https://via.placeholder.com/500x400?text=Banner+Toko'/>
        </div>
      </div>
    </div>
  </section>

  <!-- FITUR UNGGULAN -->
  <section class='py-5'>
    <div class='container'>
      <div class='row text-center'>
        <div class='col-md-4 mb-4'>
          <div class='p-3 border rounded h-100'>
            <h3 class='h4'>👕 Kualitas Premium</h3>
            <p>Bahan katun pilihan yang sejuk dan menyerap keringat.</p>
          </div>
        </div>
        <div class='col-md-4 mb-4'>
          <div class='p-3 border rounded h-100'>
            <h3 class='h4'>🚚 Pengiriman Cepat</h3>
            <p>Kirim ke seluruh Indonesia dengan jaminan barang sampai.</p>
          </div>
        </div>
        <div class='col-md-4 mb-4'>
          <div class='p-3 border rounded h-100'>
            <h3 class='h4'>💳 Pembayaran Mudah</h3>
            <p>Transfer Bank dan E-Wallet tersedia untuk kemudahanmu.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PEMISAH KATALOG (Anchor Link) -->
  <div class='container py-2' id='katalog'/>

    <!-- MAIN CONTENT AREA -->
  <main>
    <b:section class='container py-5' id='main' showaddelement='yes'>
      
      <!-- WIDGET BLOG1 (BERSIH & LENGKAP) -->
      <b:widget id='Blog1' locked='false' title='Postingan Blog' type='Blog' version='2' visible='true'>
        
        <!-- LOGIKA UTAMA -->
        <b:includable id='main'>
          <b:if cond='data:blog.pageType == &quot;item&quot;'>
            <!-- Halaman Detail Produk -->
            <b:loop values='data:posts' var='post'>
              <b:include data='post' name='post'/>
            </b:loop>
          <b:else/>
            <!-- Halaman Depan (Katalog) -->
            <div class='container py-2'></div>
            <h2 class='text-center mb-5 fw-bold'>Katalog Produk</h2>
            
            <div class='row row-cols-1 row-cols-md-3 g-4'>
              <b:loop values='data:posts' var='post'>
                <div class='col'>
                  <div class='card h-100 shadow-sm border-0 product-card'>
                    <a expr:href='data:post.url'>
                      <b:if cond='data:post.featuredImage'>
                        <img class='card-img-top' expr:src='data:post.featuredImage' expr:alt='data:post.title' style='object-fit: cover; height: 250px;'/>
                      <b:else/>
                        <img class='card-img-top' src='https://via.placeholder.com/300x250?text=No+Image' alt='No Image' style='object-fit: cover; height: 250px;'/>
                      </b:if>
                    </a>
                    <div class='card-body d-flex flex-column'>
                      <h5 class='card-title fw-bold'>
                        <a expr:href='data:post.url' class='text-decoration-none text-dark'><data:post.title/></a>
                      </h5>
                      <div class='card-text text-muted small'><data:post.snippet/></div>
                      <div class='mt-auto pt-3'>
                        <p class='fw-bold text-primary h4 mb-2'>Rp 150.000</p>
                        <a class='btn btn-outline-success w-100' expr:href='data:post.url'>Lihat Detail &amp; Beli</a>
                      </div>
                    </div>
                  </div>
                </div>
              </b:loop>
            </div>
            
            <!-- Pagination -->
            <div class='blog-pager mt-5 text-center'>
              <b:if cond='data:newerPageUrl'>
                <a class='btn btn-primary me-2' expr:href='data:newerPageUrl'>Sebelumnya</a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='btn btn-primary' expr:href='data:olderPageUrl'>Berikutnya</a>
              </b:if>
            </div>
          </b:if>
        </b:includable>
        
        <!-- TAMPILAN DETAIL PRODUK -->
        <b:includable id='post' var='post'>
          <div class='container py-5'>
            <article class='row'>
              <div class='col-md-6 mb-4'>
                <b:if cond='data:post.featuredImage'>
                  <img class='img-fluid rounded shadow' expr:src='data:post.featuredImage' expr:alt='data:post.title'/>
                <b:else/>
                  <img class='img-fluid rounded shadow' src='https://via.placeholder.com/600x400?text=No+Image' alt='No Image'/>
                </b:if>
              </div>
              <div class='col-md-6'>
                <h1 class='fw-bold mb-3'><data:post.title/></h1>
                <h3 class='text-primary fw-bold mb-4'>Rp 150.000</h3>
                <div class='mb-5 text-muted'>
                  <data:post.body/>
                </div>
                <hr/>
                <!-- FORMULIR -->
                <div class='bg-light p-4 rounded shadow-sm'>
                  <h5 class='mb-3'>Form Pemesanan</h5>
                  <form id='orderForm' onsubmit='kirimWhatsApp(event)'>
                    <div class='mb-3'>
                      <label class='form-label'>Nama Lengkap</label>
                      <input id='nama' class='form-control' placeholder='Masukkan nama anda' required='required' type='text'/>
                    </div>
                    <div class='mb-3'>
                      <label class='form-label'>Nomor WhatsApp</label>
                      <input id='whatsapp' class='form-control' placeholder='Contoh: 08123456789' required='required' type='tel'/>
                    </div>
                    <div class='row'>
                      <div class='col-md-6 mb-3'>
                        <label class='form-label'>Ukuran</label>
                        <select id='ukuran' class='form-select'>
                          <option value='S'>S</option>
                          <option value='M'>M</option>
                          <option value='L'>L</option>
                          <option value='XL'>XL</option>
                        </select>
                      </div>
                      <div class='col-md-6 mb-3'>
                        <label class='form-label'>Warna</label>
                        <select id='warna' class='form-select'>
                          <option value='Hitam'>Hitam</option>
                          <option value='Putih'>Putih</option>
                          <option value='Merah'>Merah</option>
                          <option value='Biru'>Biru</option>
                        </select>
                      </div>
                    </div>
                    <div class='mb-3'>
                      <label class='form-label'>Alamat Lengkap</label>
                      <textarea id='alamat' class='form-control' rows='3' placeholder='Jalan, No Rumah, Kecamatan, Kota...' required='required'></textarea>
                    </div>
                    <input expr:value='data:post.title' id='namaProduk' type='hidden'/>
                    <button class='btn btn-success w-100 fw-bold py-2' type='submit'>Beli via WhatsApp</button>
                  </form>
                </div>
              </div>
            </article>
          </div>
        </b:includable>
        
      </b:widget>
      
    </b:section>
  </main>

  <!-- FOOTER -->
  <footer class='bg-dark text-white py-4 mt-5'>
    <div class='container text-center'>
      <p class='mb-0'> 2024 Toko Baju Kita. All rights reserved.</p>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script crossorigin='anonymous' integrity='sha384-C6RzynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL' src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js'/>
  
</body>
</html>